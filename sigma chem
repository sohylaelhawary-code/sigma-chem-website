<script>
/* ── Products Data ───────────────────── */
const products = [
  { name: "Mono Ethylene Glycol",  origin: "Saudi",           tag: "saudi" },
  { name: "Di Ethylene Glycol",    origin: "Saudi",           tag: "saudi" },
  { name: "Mono Propylene Glycol", origin: "Saudi",           tag: "saudi" },
  { name: "Tri Ethanol Amine",     origin: "Saudi",           tag: "saudi" },
  { name: "Caustic Soda Solution", origin: "Saudi",           tag: "saudi" },
  { name: "Cemsol",                origin: "American / Indian", tag: "other" },
  { name: "Ethylene",              origin: "European",        tag: "european" },
  { name: "Toluene",               origin: "Egyptian",        tag: "egyptian" },
  { name: "Kerosene Odorless",     origin: "Egyptian",        tag: "egyptian" },
  { name: "Methylene Chloride",    origin: "Chinese",         tag: "chinese" },
  { name: "Foaming Agent",         origin: "Egyptian",        tag: "egyptian" },
  { name: "Polyethylene Glycol",   origin: "Saudi",           tag: "saudi" },
  { name: "DMF",                   origin: "Saudi / Italy",   tag: "saudi" },
  { name: "Methanol",              origin: "Egyptian",        tag: "egyptian" },
  { name: "Hexane",                origin: "Egyptian",        tag: "egyptian" },
  { name: "Glycerin",              origin: "Various",         tag: "other" },
  { name: "Acetic Acid",           origin: "Korean",          tag: "other" },
  { name: "Citric Acid",           origin: "Chinese",         tag: "chinese" },
  { name: "Lactic Acid",           origin: "Asian",           tag: "other" }
];

/* ── Render Products ─────────────────── */
function renderProducts(filter = 'all') {
  const grid = document.getElementById('productsGrid');
  const filtered = filter === 'all' ? products : products.filter(p => p.tag === filter);

  grid.innerHTML = filtered.map((p, i) => `
    <div class="product-card">
      <div class="product-num">${String(i + 1).padStart(2, '0')}</div>
      <div class="product-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/>
        </svg>
      </div>
      <div class="product-name">${p.name}</div>
      <div class="product-origin">${p.origin}</div>
    </div>
  `).join('');
}

renderProducts();

/* ── Filter Buttons ──────────────────── */
document.querySelectorAll('.filter-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    renderProducts(btn.dataset.filter);
  });
});

/* ── Navbar Scroll ───────────────────── */
const navbar = document.getElementById('navbar');
window.addEventListener('scroll', () => {
  navbar.classList.toggle('scrolled', window.scrollY > 60);
}, { passive: true });

/* ── Scroll Reveal ───────────────────── */
const revealEls = document.querySelectorAll('.reveal');
const observer = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      e.target.classList.add('visible');
      observer.unobserve(e.target);
    }
  });
}, { threshold: 0.12 });
revealEls.forEach(el => observer.observe(el));

/* ── Molecular Floating Nodes ────────── */
(function() {
  const container = document.getElementById('molNodes');
  const nodes = [
    { size:8,  top:'18%', left:'15%', dur:'9s',  delay:'0s',   op:.45, tx:'30px',  ty:'-20px', sc:1.4 },
    { size:5,  top:'65%', left:'12%', dur:'12s', delay:'.8s',  op:.3,  tx:'-20px', ty:'30px',  sc:.8  },
    { size:12, top:'30%', left:'80%', dur:'10s', delay:'1.2s', op:.5,  tx:'20px',  ty:'40px',  sc:1.2 },
    { size:6,  top:'75%', left:'75%', dur:'8s',  delay:'.4s',  op:.35, tx:'-30px', ty:'-15px', sc:1.5 },
    { size:9,  top:'50%', left:'55%', dur:'14s', delay:'1.8s', op:.25, tx:'25px',  ty:'-35px', sc:.9  },
    { size:4,  top:'85%', left:'40%', dur:'11s', delay:'.2s',  op:.4,  tx:'-15px', ty:'25px',  sc:1.3 },
    { size:7,  top:'10%', left:'60%', dur:'13s', delay:'2.5s', op:.3,  tx:'35px',  ty:'15px',  sc:.85 },
    { size:3,  top:'40%', left:'30%', dur:'7s',  delay:'1s',   op:.5,  tx:'-10px', ty:'-30px', sc:1.6 },
  ];
  nodes.forEach(n => {
    const el = document.createElement('div');
    el.className = 'node';
    el.style.cssText = `
      width:${n.size}px; height:${n.size}px;
      top:${n.top}; left:${n.left};
      --dur:${n.dur}; --delay:${n.delay};
      --op:${n.op}; --tx:${n.tx}; --ty:${n.ty}; --sc:${n.sc};
    `;
    container.appendChild(el);
  });
})();
</script>
