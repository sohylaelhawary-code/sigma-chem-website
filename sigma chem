<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SIGMA CHEM — Industrial Chemical Supplier Egypt</title>
  <meta name="description" content="SIGMA CHEM — Premium industrial chemical supplier and distributor in Egypt. High-quality chemicals with international sourcing network." />
  <meta name="keywords" content="chemical supplier Egypt, industrial chemicals Egypt, Sigma Chem, chemical distribution company" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@300;400;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet" />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --navy:   #0B1F3B;
      --blue:   #5FA8D3;
      --white:  #FFFFFF;
      --accent: #D9E6F2;
      --mid:    #1A3355;
      --dim:    #8aaccc;
      --gutter: clamp(1.5rem, 5vw, 4rem);
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--white);
      color: var(--navy);
      overflow-x: hidden;
    }

    /* ─── NAV ─────────────────────────────────────── */
    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.2rem var(--gutter);
      transition: background .4s, backdrop-filter .4s, box-shadow .4s;
    }
    nav.scrolled {
      background: rgba(11, 31, 59, .92);
      backdrop-filter: blur(12px);
      box-shadow: 0 2px 30px rgba(0,0,0,.25);
    }
    .nav-logo {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 800;
      font-size: 1.6rem;
      letter-spacing: .06em;
      color: var(--white);
      text-decoration: none;
    }
    .nav-logo span { color: var(--blue); }
    .nav-links { display: flex; gap: 2rem; list-style: none; }
    .nav-links a {
      color: rgba(255,255,255,.75);
      text-decoration: none;
      font-size: .85rem;
      letter-spacing: .08em;
      text-transform: uppercase;
      font-weight: 500;
      transition: color .2s;
    }
    .nav-links a:hover { color: var(--blue); }

    /* ─── HERO ────────────────────────────────────── */
    #hero {
      position: relative;
      min-height: 100vh;
      background: var(--navy);
      display: flex;
      align-items: center;
      overflow: hidden;
    }

    /* Molecular grid background */
    .hero-bg {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 70% 40%, rgba(95,168,211,.18) 0%, transparent 55%),
        radial-gradient(circle at 20% 80%, rgba(95,168,211,.1) 0%, transparent 45%);
    }

    /* Hexagon lattice */
    .hex-grid {
      position: absolute;
      inset: 0;
      overflow: hidden;
      opacity: .12;
    }
    .hex-grid svg { width: 100%; height: 100%; }

    /* Floating molecular nodes */
    .mol-nodes {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }
    .node {
      position: absolute;
      border-radius: 50%;
      background: var(--blue);
      opacity: 0;
      animation: float-node var(--dur) var(--delay) ease-in-out infinite alternate;
    }
    @keyframes float-node {
      0%   { opacity: 0; transform: translate(0, 0) scale(1); }
      30%  { opacity: var(--op); }
      70%  { opacity: var(--op); }
      100% { opacity: 0; transform: translate(var(--tx), var(--ty)) scale(var(--sc)); }
    }

    /* Diagonal accent bar */
    .hero-bar {
      position: absolute;
      top: 0; right: 0;
      width: 38%;
      height: 100%;
      background: linear-gradient(160deg, rgba(95,168,211,.08) 0%, rgba(95,168,211,.03) 100%);
      clip-path: polygon(12% 0, 100% 0, 100% 100%, 0% 100%);
      border-left: 1px solid rgba(95,168,211,.15);
    }

    .hero-content {
      position: relative;
      z-index: 2;
      padding: 0 var(--gutter);
      max-width: 820px;
    }

    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: .6rem;
      color: var(--blue);
      font-size: .75rem;
      font-weight: 500;
      letter-spacing: .2em;
      text-transform: uppercase;
      margin-bottom: 1.6rem;
      opacity: 0;
      animation: fade-up .7s .3s forwards;
    }
    .hero-eyebrow::before {
      content: '';
      display: block;
      width: 2rem;
      height: 1px;
      background: var(--blue);
    }

    .hero-headline {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: clamp(5rem, 14vw, 11rem);
      font-weight: 800;
      line-height: .9;
      letter-spacing: -.01em;
      color: var(--white);
      opacity: 0;
      animation: fade-up .8s .5s forwards;
    }
    .hero-headline .accent { color: var(--blue); }

    .hero-sub {
      margin-top: 1.6rem;
      font-size: clamp(1rem, 2vw, 1.3rem);
      font-weight: 300;
      color: rgba(255,255,255,.65);
      letter-spacing: .04em;
      max-width: 480px;
      opacity: 0;
      animation: fade-up .8s .75s forwards;
    }

    .hero-cta {
      display: inline-flex;
      align-items: center;
      gap: .8rem;
      margin-top: 2.5rem;
      padding: .9rem 2rem;
      background: var(--blue);
      color: var(--white);
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase;
      text-decoration: none;
      border: none;
      cursor: pointer;
      position: relative;
      overflow: hidden;
      clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 12px 100%, 0 calc(100% - 12px));
      transition: background .25s;
      opacity: 0;
      animation: fade-up .8s 1s forwards;
    }
    .hero-cta:hover { background: #7abde0; }
    .hero-cta svg { width: 18px; height: 18px; }

    .hero-scroll-hint {
      position: absolute;
      bottom: 2.5rem;
      left: var(--gutter);
      display: flex;
      align-items: center;
      gap: .8rem;
      color: rgba(255,255,255,.35);
      font-size: .7rem;
      letter-spacing: .15em;
      text-transform: uppercase;
      opacity: 0;
      animation: fade-up .8s 1.3s forwards;
    }
    .scroll-line {
      width: 3rem;
      height: 1px;
      background: rgba(255,255,255,.2);
      position: relative;
      overflow: hidden;
    }
    .scroll-line::after {
      content: '';
      position: absolute;
      top: 0; left: -100%;
      width: 100%; height: 100%;
      background: var(--blue);
      animation: slide-line 2s 1.5s ease-in-out infinite;
    }
    @keyframes slide-line {
      0%   { left: -100%; }
      100% { left: 100%; }
    }

    /* ─── ABOUT ───────────────────────────────────── */
    #about {
      background: var(--white);
      padding: clamp(5rem, 10vw, 9rem) var(--gutter);
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
    }
    @media (max-width: 768px) { #about { grid-template-columns: 1fr; } }

    .about-label {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: .75rem;
      font-weight: 700;
      letter-spacing: .25em;
      text-transform: uppercase;
      color: var(--blue);
      margin-bottom: .8rem;
    }
    .about-title {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: clamp(2.4rem, 5vw, 3.8rem);
      font-weight: 700;
      line-height: 1.05;
      color: var(--navy);
      margin-bottom: 1.6rem;
    }
    .about-body {
      font-size: 1.05rem;
      line-height: 1.85;
      color: #4a6080;
      direction: rtl;
      text-align: right;
      font-weight: 400;
    }
    .about-location {
      display: flex;
      align-items: flex-start;
      gap: .6rem;
      margin-top: 1.4rem;
      font-size: .9rem;
      color: #4a6080;
      direction: rtl;
      text-align: right;
    }
    .about-location svg { color: var(--blue); flex-shrink: 0; margin-top: 2px; }

    /* Stats panel */
    .about-stats {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
    .stat-card {
      background: var(--navy);
      padding: 2rem 1.5rem;
      position: relative;
      overflow: hidden;
      clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 14px 100%, 0 calc(100% - 14px));
    }
    .stat-card::before {
      content: '';
      position: absolute;
      inset: 1px;
      background: linear-gradient(135deg, var(--mid), var(--navy));
      clip-path: polygon(0 0, calc(100% - 13px) 0, 100% 13px, 100% 100%, 13px 100%, 0 calc(100% - 13px));
      z-index: 0;
    }
    .stat-card > * { position: relative; z-index: 1; }
    .stat-num {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 2.8rem;
      font-weight: 800;
      color: var(--blue);
      line-height: 1;
    }
    .stat-label {
      font-size: .78rem;
      color: rgba(255,255,255,.5);
      letter-spacing: .08em;
      text-transform: uppercase;
      margin-top: .4rem;
    }

    /* ─── PRODUCTS ────────────────────────────────── */
    #products {
      background: #F4F8FC;
      padding: clamp(5rem, 10vw, 9rem) var(--gutter);
    }

    .section-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      margin-bottom: 3rem;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .section-label {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: .75rem;
      font-weight: 700;
      letter-spacing: .25em;
      text-transform: uppercase;
      color: var(--blue);
      margin-bottom: .5rem;
    }
    .section-title {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 700;
      color: var(--navy);
      line-height: 1.05;
    }
    .section-count {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 5rem;
      font-weight: 800;
      color: rgba(11,31,59,.06);
      line-height: 1;
      user-select: none;
    }

    /* Filter tabs */
    .filter-bar {
      display: flex;
      gap: .5rem;
      flex-wrap: wrap;
      margin-bottom: 2.5rem;
    }
    .filter-btn {
      padding: .45rem 1.1rem;
      border: 1px solid rgba(11,31,59,.2);
      background: transparent;
      color: #4a6080;
      font-family: 'DM Sans', sans-serif;
      font-size: .8rem;
      letter-spacing: .04em;
      cursor: pointer;
      transition: all .2s;
      clip-path: polygon(0 0, calc(100% - 6px) 0, 100% 6px, 100% 100%, 6px 100%, 0 calc(100% - 6px));
    }
    .filter-btn.active, .filter-btn:hover {
      background: var(--navy);
      color: var(--white);
      border-color: var(--navy);
    }

    .products-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 1px;
      background: rgba(11,31,59,.08);
      border: 1px solid rgba(11,31,59,.08);
    }

    .product-card {
      background: var(--white);
      padding: 1.6rem 1.4rem;
      position: relative;
      overflow: hidden;
      transition: background .2s;
      display: flex;
      flex-direction: column;
      gap: .6rem;
      cursor: default;
    }
    .product-card::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0;
      width: 0; height: 2px;
      background: var(--blue);
      transition: width .3s ease;
    }
    .product-card:hover { background: var(--accent); }
    .product-card:hover::after { width: 100%; }

    .product-icon {
      width: 36px;
      height: 36px;
      background: linear-gradient(135deg, var(--navy), var(--mid));
      display: flex;
      align-items: center;
      justify-content: center;
      clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
      margin-bottom: .2rem;
      flex-shrink: 0;
    }
    .product-icon svg { color: var(--blue); width: 16px; height: 16px; }

    .product-name {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--navy);
      letter-spacing: .02em;
      line-height: 1.2;
    }
    .product-origin {
      display: inline-flex;
      align-items: center;
      gap: .35rem;
      font-size: .7rem;
      color: var(--blue);
      font-weight: 500;
      letter-spacing: .08em;
      text-transform: uppercase;
    }
    .product-origin::before {
      content: '';
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: var(--blue);
      flex-shrink: 0;
    }
    .product-num {
      position: absolute;
      top: 1rem; right: 1.2rem;
      font-family: 'Barlow Condensed', sans-serif;
      font-size: .7rem;
      font-weight: 700;
      color: rgba(11,31,59,.1);
      letter-spacing: .05em;
    }

    /* ─── CONTACT ─────────────────────────────────── */
    #contact {
      background: var(--navy);
      padding: clamp(5rem, 10vw, 9rem) var(--gutter) 3rem;
      position: relative;
      overflow: hidden;
    }
    #contact::before {
      content: '';
      position: absolute;
      top: -30%;
      right: -10%;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(95,168,211,.1) 0%, transparent 70%);
      pointer-events: none;
    }

    .contact-grid {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 5rem;
      position: relative;
      z-index: 1;
    }
    @media (max-width: 768px) { .contact-grid { grid-template-columns: 1fr; gap: 3rem; } }

    .contact-headline {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: clamp(2.8rem, 6vw, 5rem);
      font-weight: 800;
      color: var(--white);
      line-height: 1;
      margin-bottom: 1rem;
    }
    .contact-headline span { color: var(--blue); }
    .contact-sub {
      color: rgba(255,255,255,.45);
      font-size: .95rem;
      line-height: 1.7;
      max-width: 420px;
    }

    .contact-items { display: flex; flex-direction: column; gap: 1.4rem; }

    .contact-item {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
    }
    .contact-ico {
      width: 42px;
      height: 42px;
      background: rgba(95,168,211,.12);
      border: 1px solid rgba(95,168,211,.2);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
    }
    .contact-ico svg { color: var(--blue); width: 18px; height: 18px; }
    .contact-info-label {
      font-size: .65rem;
      font-weight: 700;
      letter-spacing: .18em;
      text-transform: uppercase;
      color: var(--blue);
      margin-bottom: .25rem;
    }
    .contact-info-value {
      color: rgba(255,255,255,.85);
      font-size: .9rem;
      line-height: 1.6;
    }
    .contact-info-value a {
      color: inherit;
      text-decoration: none;
      transition: color .2s;
    }
    .contact-info-value a:hover { color: var(--blue); }

    /* Footer strip */
    .footer-strip {
      margin-top: 4rem;
      padding-top: 1.5rem;
      border-top: 1px solid rgba(255,255,255,.08);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1rem;
      position: relative;
      z-index: 1;
    }
    .footer-logo {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 800;
      font-size: 1.4rem;
      color: rgba(255,255,255,.3);
      letter-spacing: .06em;
    }
    .footer-logo span { color: var(--blue); opacity: .6; }
    .footer-copy {
      font-size: .75rem;
      color: rgba(255,255,255,.2);
      letter-spacing: .05em;
    }

    /* ─── ANIMATIONS ──────────────────────────────── */
    @keyframes fade-up {
      from { opacity: 0; transform: translateY(28px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .reveal {
      opacity: 0;
      transform: translateY(32px);
      transition: opacity .7s ease, transform .7s ease;
    }
    .reveal.visible {
      opacity: 1;
      transform: none;
    }
    .reveal-delay-1 { transition-delay: .1s; }
    .reveal-delay-2 { transition-delay: .2s; }
    .reveal-delay-3 { transition-delay: .3s; }
    .reveal-delay-4 { transition-delay: .4s; }

    /* ─── RESPONSIVE ──────────────────────────────── */
    @media (max-width: 600px) {
      .nav-links { display: none; }
      .about-stats { grid-template-columns: 1fr 1fr; }
      .section-header { flex-direction: column; align-items: flex-start; }
    }
  </style>
</head>
<body>

<!-- ═══════════════════════════════════════
     NAV
════════════════════════════════════════ -->
<nav id="navbar">
  <a class="nav-logo" href="#">SIGMA<span>CHEM</span></a>
  <ul class="nav-links">
    <li><a href="#about">About</a></li>
    <li><a href="#products">Products</a></li>
    <li><a href="#contact">Contact</a></li>
  </ul>
</nav>

<!-- ═══════════════════════════════════════
     HERO
════════════════════════════════════════ -->
<section id="hero">
  <div class="hero-bg"></div>

  <!-- SVG Hexagon lattice -->
  <div class="hex-grid">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice">
      <defs>
        <pattern id="hexPat" x="0" y="0" width="80" height="92" patternUnits="userSpaceOnUse">
          <polygon points="40,2 78,22 78,62 40,82 2,62 2,22" fill="none" stroke="#5FA8D3" stroke-width=".6"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hexPat)"/>
    </svg>
  </div>

  <!-- Floating molecular nodes -->
  <div class="mol-nodes" id="molNodes"></div>

  <div class="hero-bar"></div>

  <div class="hero-content">
    <div class="hero-eyebrow">Industrial Chemical Solutions</div>

    <h1 class="hero-headline">
      SIGMA<br><span class="accent">CHEM</span>
    </h1>

    <p class="hero-sub">Discover A New Chemical Dimension</p>

    <a href="#products" class="hero-cta">
      Explore Products
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"/>
        <polyline points="12 5 19 12 12 19"/>
      </svg>
    </a>
  </div>

  <div class="hero-scroll-hint">
    <div class="scroll-line"></div>
    Scroll to explore
  </div>
</section>

<!-- ═══════════════════════════════════════
     ABOUT
════════════════════════════════════════ -->
<section id="about">
  <div class="reveal">
    <div class="about-label">Who We Are</div>
    <h2 class="about-title">About<br>SIGMA CHEM</h2>
    <p class="about-body">
      شركة متخصصة في توريد وتوزيع المواد الكيميائية الصناعية عالية الجودة مع شبكة موموردين دولية تضمن تنوع وجودة المنتجات.
    </p>
    <div class="about-location">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
      </svg>
      مدينة السادات - مول خدمات المنطقة الثانية
    </div>
  </div>

  <div class="about-stats reveal reveal-delay-2">
    <div class="stat-card">
      <div class="stat-num">19+</div>
      <div class="stat-label">Chemical Products</div>
    </div>
    <div class="stat-card">
      <div class="stat-num">8+</div>
      <div class="stat-label">Source Countries</div>
    </div>
    <div class="stat-card">
      <div class="stat-num">100%</div>
      <div class="stat-label">Industrial Grade</div>
    </div>
    <div class="stat-card">
      <div class="stat-num">EG</div>
      <div class="stat-label">Egypt Based</div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════
     PRODUCTS
════════════════════════════════════════ -->
<section id="products">
  <div class="section-header reveal">
    <div>
      <div class="section-label">Chemical Catalog</div>
      <h2 class="section-title">Our Chemicals</h2>
    </div>
    <div class="section-count">19</div>
  </div>

  <div class="filter-bar reveal reveal-delay-1">
    <button class="filter-btn active" data-filter="all">All Origins</button>
    <button class="filter-btn" data-filter="saudi">Saudi</button>
    <button class="filter-btn" data-filter="egyptian">Egyptian</button>
    <button class="filter-btn" data-filter="chinese">Chinese</button>
    <button class="filter-btn" data-filter="european">European</button>
    <button class="filter-btn" data-filter="other">Others</button>
  </div>

  <div class="products-grid" id="productsGrid"></div>
</section>

<!-- ═══════════════════════════════════════
     CONTACT
════════════════════════════════════════ -->
<section id="contact">
  <div class="contact-grid">
    <div class="reveal">
      <div class="section-label" style="color:var(--dim)">Get In Touch</div>
      <h2 class="contact-headline">Let's<br>Connect<br><span>Today</span></h2>
      <p class="contact-sub">Reach out to discuss your industrial chemical requirements. We serve businesses across Egypt with premium sourced materials.</p>
    </div>

    <div class="contact-items reveal reveal-delay-2">

      <!-- Phones -->
